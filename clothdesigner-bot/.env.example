# ClothDesigner bot configuration.
# Copy to .env and fill in. Every key is optional except DISCORD_TOKEN /
# DISCORD_CLIENT_ID when you want the live Discord layer.

# Discord bot token from https://discord.com/developers/applications
# (Bot -> Reset Token). LEAVE EMPTY to run in DRY-RUN mode: the HTTP API
# still works, and "posted" cards are written to data/outbox/ instead of
# Discord. All storage/auth/routing behaves identically.
DISCORD_TOKEN=

# Application (client) ID from the same Discord application. Needed by
# `npm run register` (slash-command registration) and for the invite URL.
DISCORD_CLIENT_ID=

# Port the HTTP API listens on.
PORT=8085

# Public base URL game servers and admins reach this bot at. Used to build
# download links for packs too big to attach. No trailing slash.
PUBLIC_URL=http://localhost:8085

# Where servers.json / uploads.json / stored files / dry-run outbox live.
# Relative paths are resolved against the project root.
DATA_DIR=./data

# Reject uploads whose decoded pack exceeds this many megabytes.
MAX_UPLOAD_MB=30

# Packs at or below this size (MB) are attached to the Discord message
# directly; larger ones get a PUBLIC_URL download link instead. Discord's
# default bot attachment cap is 8 MB, hence 7.5 for headroom.
ATTACH_LIMIT_MB=7.5
